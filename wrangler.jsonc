{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "server-status",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "server-status",
      "database_id": "3ab8ff33-7de7-49b9-b038-1a4b4ef4b9be"
    }
  ]
}
